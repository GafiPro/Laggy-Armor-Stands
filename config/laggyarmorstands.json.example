{
  "enabled": true,
  "hideArmorStands": true,
  "optimizeStationaryTicks": true,
  "skipInterval": 20,
  "skipWhenOnGround": true,
  "skipWhenNoGravity": true,
  "dontSkipIfRiding": true,
  "dontSkipIfHasPassengers": true,
  "dontSkipIfOnFire": true,
  "dontSkipIfMoving": true,
  "dontSkipIfHurt": true
}
